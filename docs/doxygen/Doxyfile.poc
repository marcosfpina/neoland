# Doxygen proof-of-concept — single-file scope (src/health.rs) to validate
# the Rust INPUT_FILTER before scaling to the rest of the codebase.
# Run from the neoland repo root: doxygen docs/doxygen/Doxyfile.poc

PROJECT_NAME           = "Neoland (Doxygen POC)"
OUTPUT_DIRECTORY       = docs/doxygen/output-poc
INPUT                  = src/health.rs
RECURSIVE              = NO
FILE_PATTERNS          = *.rs

EXTENSION_MAPPING      = rs=C++
FILTER_PATTERNS        = *.rs="python3 docs/doxygen/rust_filter.py"

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
QUIET                  = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_NO_PARAMDOC       = NO

# syntax=docker/dockerfile:1.7
# Build context: master/  (one level above neoland/ — needed for spectre/ path dep)
# Build with:
#   eval $(ssh-agent) && ssh-add ~/.ssh/id_ed25519
#   DOCKER_BUILDKIT=1 docker compose build --ssh default

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM rust:1.82-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates git openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# spectre/ is a path dependency — must be present before cargo fetch
COPY spectre/ spectre/
COPY neoland/ neoland/

WORKDIR /build/neoland

# Fetch crates; SSH agent required for private github deps
RUN --mount=type=ssh \
    --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo fetch --locked

# Build release binary
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/neoland/target,sharing=locked \
    cargo build --bin neoland --release && \
    cp target/release/neoland /usr/local/bin/neoland-bin

# Build sqlx-cli for DB migrations (reuses registry cache)
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo install sqlx-cli --no-default-features --features postgres && \
    cp /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx-bin

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1001 -s /bin/false neoland \
    && mkdir -p /var/lib/neoland/checkpoints/adr /run/neoland /app/migrations \
    && chown -R neoland:neoland /var/lib/neoland /run/neoland

COPY --from=builder /usr/local/bin/neoland-bin  /usr/local/bin/neoland
COPY --from=builder /usr/local/bin/sqlx-bin     /usr/local/bin/sqlx
COPY neoland/migrations/                        /app/migrations/
COPY neoland/deploy/docker/entrypoint.sh        /entrypoint.sh

RUN chmod +x /entrypoint.sh

USER neoland
EXPOSE 50051 3001

ENTRYPOINT ["/entrypoint.sh"]
CMD ["server"]

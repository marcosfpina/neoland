# syntax=docker/dockerfile:1.7
# Build context: master/deploy/  (contains neoland/, spectre/, intelagent/, securellm-bridge/)
# Path patches are in neoland/.cargo/config.toml
#
# Build:
#   docker compose -f docker-compose.master.yml --profile neoland build neoland-control-plane

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM rust:1.95-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev ca-certificates git protobuf-compiler curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy all path dependencies (needed for the .cargo/config.toml patches)
COPY spectre/ spectre/
COPY neoland/ neoland/
COPY intelagent/ intelagent/
COPY securellm-bridge/ securellm-bridge/

WORKDIR /build/neoland


# Fetch crates (uses .cargo/config.toml path patches for local deps)
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    cargo fetch --locked

# Build release binary
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/build/neoland/target,sharing=locked \
    cargo build --bin neoland --release && \
    cp target/release/neoland /usr/local/bin/neoland-bin

# Build sqlx-cli for DB migrations
RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    cargo install sqlx-cli --no-default-features --features postgres && \
    cp /usr/local/cargo/bin/sqlx /usr/local/bin/sqlx-bin

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1001 -s /bin/false neoland \
    && mkdir -p /var/lib/neoland/checkpoints/adr /run/neoland /app/migrations \
    && chown -R neoland:neoland /var/lib/neoland /run/neoland

COPY --from=builder /usr/local/bin/neoland-bin  /usr/local/bin/neoland
COPY --from=builder /usr/local/bin/sqlx-bin     /usr/local/bin/sqlx
COPY neoland/migrations/                        /app/migrations/
COPY neoland/deploy/docker/entrypoint.sh        /entrypoint.sh

RUN chmod +x /entrypoint.sh

USER neoland
EXPOSE 50051 3001

ENTRYPOINT ["/entrypoint.sh"]
CMD ["server"]

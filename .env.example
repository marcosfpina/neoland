# =============================================================================
# neoland — variáveis de ambiente
# Copie para .env e preencha os valores marcados com REQUIRED.
# Valores sem comentário REQUIRED têm default seguro para desenvolvimento local.
#
# Carregamento:
#   • flake.nix shellHook lê este arquivo via SOPS se NEOLAND_SOPS_ENV_FILE
#     apontar para a versão criptografada (secrets/neoland.sops.env).
#   • Para desenvolvimento sem SOPS: `cp .env.example .env && $EDITOR .env`
#   • Nunca faça commit de .env com chaves reais — ele está no .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# SERVIDOR RUST (neoland server)
# -----------------------------------------------------------------------------

# Porta gRPC do servidor. Padrão: 50051
NEOLAND_GRPC_PORT=50051

# Porta REST/HTTP do servidor. Padrão: 3001
# Endpoint Prometheus estará em http://localhost:$NEOLAND_REST_PORT/metrics
NEOLAND_REST_PORT=3001

# URL que o TUI usa para alcançar o servidor gRPC.
NEOLAND_SERVER_URL=http://[::1]:50051

# URL do controle plane (servidor REST). Alias interno.
NEOLAND_CONTROL_PLANE_URL=http://127.0.0.1:3001


# -----------------------------------------------------------------------------
# AUTENTICAÇÃO — chaves de API do servidor
# Em produção prefira Vault (ver seção VAULT abaixo).
# -----------------------------------------------------------------------------

# Chave de administrador — acesso total à API REST. REQUIRED em produção.
# Gerar: openssl rand -hex 32
NEOLAND_ADMIN_API_KEY=neoland_admin_SUBSTITUA_POR_VALOR_REAL

# Chave de usuário — acesso de leitura/escrita às rotas normais.
NEOLAND_USER_API_KEY=neoland_user_SUBSTITUA_POR_VALOR_REAL

# Chave somente-leitura — acesso a /health, /metrics, leituras.
NEOLAND_READONLY_API_KEY=neoland_readonly_SUBSTITUA_POR_VALOR_REAL

# Chave usada pelo TUI para autenticar no servidor.
# Deve ser igual a uma das chaves acima (admin ou user).
NEOLAND_API_KEY=neoland_admin_SUBSTITUA_POR_VALOR_REAL

# Em produção: rejeita chaves de desenvolvimento se nenhuma chave Vault estiver
# carregada. Deixe vazio (ou 0) em desenvolvimento local.
# NEOLAND_REQUIRE_VAULT_KEYS=1


# -----------------------------------------------------------------------------
# PIPELINE DE AGENTES (DSPy / Python — neoland agents)
# -----------------------------------------------------------------------------

# Provider LLM usado pelo pipeline DSPy.
# Valores: deepseek (padrão) | groq | gemini | openai | local
# "local" usa ollama — não requer chave.
NEOLAND_LLM_PROVIDER=deepseek

# Modelo LLM. Padrão automático por provider:
#   deepseek  → deepseek-chat
#   groq      → llama-3.1-8b-instant
#   gemini    → gemini/gemini-1.5-flash
#   openai    → gpt-4o-mini
#   local     → ollama_chat/llama3.2
# NEOLAND_LLM_MODEL=deepseek-chat

# Chave genérica (qualquer provider). Alternativa às chaves específicas abaixo.
# Se definida, prevalece sobre {PROVIDER}_API_KEY.
# LLM_API_KEY=

# Chaves específicas por provider — lidas automaticamente quando
# NEOLAND_LLM_PROVIDER corresponde. Defina apenas a do provider escolhido.
DEEPSEEK_API_KEY=              # REQUIRED se NEOLAND_LLM_PROVIDER=deepseek
# GROQ_API_KEY=                # REQUIRED se NEOLAND_LLM_PROVIDER=groq
# GEMINI_API_KEY=              # REQUIRED se NEOLAND_LLM_PROVIDER=gemini
# OPENAI_API_KEY=              # REQUIRED se NEOLAND_LLM_PROVIDER=openai

# URL base do ollama. Usado apenas quando NEOLAND_LLM_PROVIDER=local.
OLLAMA_BASE_URL=http://localhost:11434

# URL do servidor FastAPI de agentes. Deve coincidir com NEOLAND_PIPELINE_PORT.
NEOLAND_DSPY_URL=http://127.0.0.1:8001

# Porta em que o servidor de agentes escuta.
NEOLAND_PIPELINE_PORT=8001

# Número de chunks RAG recuperados por query.
NEOLAND_RAG_TOP_K=5

# Timeout total do pipeline (Junior → TechLeader) em segundos.
NEOLAND_PIPELINE_TIMEOUT_SECS=120

# Threshold de confiança do Junior abaixo do qual um aviso é emitido (0.0–1.0).
NEOLAND_JUNIOR_CONFIDENCE_WARN_THRESHOLD=0.4

# Horas antes de um ADR "deferred" expirar e voltar para revisão.
NEOLAND_TECH_LEADER_DEFER_TTL_HOURS=24

# Diretório onde checkpoints de pipeline ADR são salvos.
NEOLAND_CHECKPOINT_DIR=${HOME}/.local/share/neoland/checkpoints/adr


# -----------------------------------------------------------------------------
# GATEWAY LLM (SecureLLM Bridge — serviço externo)
# URL do gateway que o servidor Rust usa para inference externa.
# -----------------------------------------------------------------------------

# URL do SecureLLM Bridge gateway.
NEOLAND_GATEWAY_URL=http://127.0.0.1:8080

# Alias legado — mesma função que NEOLAND_GATEWAY_URL.
# NEOLAND_ML_API_URL=http://127.0.0.1:8080

# Provider usado pelo TUI no caminho legado LLM (não-agente).
# Valores: deepseek | groq | gemini | llamacpp | local
# Cicle pelo TUI com Ctrl+6 — este valor define o provider inicial.
SECURELLM_PROVIDER=deepseek

# Provider de inference do servidor (config.inference.provider).
# Valores: local | deepseek | llamacpp | securellm
NEOLAND_INFERENCE_PROVIDER=local


# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------

# URL do PostgreSQL. Padrão: socket Unix local (NixOS).
DATABASE_URL=postgresql:///neoland?host=/run/postgresql

# Alias específico do neoland — prevalece sobre DATABASE_URL.
# NEOLAND_DATABASE_URL=postgresql:///neoland?host=/run/postgresql


# -----------------------------------------------------------------------------
# VAULT (HashiCorp) — segredos em produção
# Deixe vazio em desenvolvimento; o sistema faz fallback para env vars.
# -----------------------------------------------------------------------------

# Endereço do Vault.
# VAULT_ADDR=http://localhost:8200

# Token de acesso ao Vault.
# VAULT_TOKEN=


# -----------------------------------------------------------------------------
# OBSERVABILIDADE
# -----------------------------------------------------------------------------

# Endpoint OTLP gRPC para traces (OpenTelemetry).
# Deve coincidir com observability.traces.endpoint no owasaka/configs/examples/default.yaml.
# O Prometheus scrape unificado está em owasaka/deploy/prometheus/prometheus.yml.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Nome do serviço reportado nos traces.
OTEL_SERVICE_NAME=neoland

# Nível de log. Aceita sintaxe tracing/env_logger.
# Exemplos: info | debug | neoland=debug,tower_http=info
RUST_LOG=info

# Formato de log da saída padrão: pretty (dev) | json (prod) | compact (CI).
LOG_FORMAT=pretty

# Caminho do arquivo de audit log (servidor).
# AUDIT_LOG_PATH=/var/log/neoland/audit.log


# -----------------------------------------------------------------------------
# IPC / SHARED MEMORY (Rust ↔ Python zero-copy)
# -----------------------------------------------------------------------------

# Arquivo mmap usado para comunicação de flags entre o servidor Rust e o
# pipeline Python.
NEOLAND_SHM_PATH=/run/neoland/agent-flags.shm


# -----------------------------------------------------------------------------
# NATS (mensageria — desabilitado por padrão)
# Definir NEOLAND_NATS_URL habilita NATS automaticamente.
# -----------------------------------------------------------------------------

# NEOLAND_NATS_URL=nats://localhost:4222
# NEOLAND_NATS_ENABLED=false


# -----------------------------------------------------------------------------
# MCP (Model Context Protocol — desabilitado por padrão)
# Definir NEOLAND_MCP_BINARY habilita o processo MCP automaticamente.
# -----------------------------------------------------------------------------

# NEOLAND_MCP_BINARY=securellm-mcp
# NEOLAND_MCP_ENABLED=false


# -----------------------------------------------------------------------------
# MATRIX (serviço de ranking/métricas — desabilitado por padrão)
# Definir NEOLAND_MATRIX_URL habilita o envio de métricas de pipeline.
# -----------------------------------------------------------------------------

# NEOLAND_MATRIX_URL=http://localhost:8002
# NEOLAND_MATRIX_ENABLED=false


# -----------------------------------------------------------------------------
# SOPS (criptografia de segredos — opcional)
# Se definido, o shellHook do flake.nix decripta e carrega o arquivo antes
# de iniciar o ambiente de desenvolvimento.
# -----------------------------------------------------------------------------

# Arquivo .env criptografado com SOPS. Padrão: secrets/neoland.sops.env
# NEOLAND_SOPS_ENV_FILE=secrets/neoland.sops.env

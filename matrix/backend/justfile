# AI Assistant Backend - Just Commands
# =====================================
# Task runner for common development operations.
#
# Usage:
#   just --list       - Show all available commands
#   just dev          - Start development server
#   just test         - Run tests
#   just setup        - Complete setup (deps + db + test)

# Variables
export PYTHONPATH := "src"
export STF_PATH := env_var_or_default('STF_PATH', '/home/kernelcore/master/adr-ledger/.stf/neutron.stf')
export DATABASE_URL := env_var_or_default('DATABASE_URL', 'postgresql://localhost:5432/ai_agent_hub')
export ALLOWED_ORIGINS := env_var_or_default('ALLOWED_ORIGINS', 'http://localhost:3006,http://localhost:3001')

# Default recipe (runs when just `just` is called)
default:
    @just --list

# Development
# ===========

# Start development server with auto-reload
dev:
    @echo "🚀 Starting backend on http://localhost:8005"
    uvicorn src.ranking.main:app --reload --host 0.0.0.0 --port 8005

# Start development server in background
dev-bg:
    @echo "🚀 Starting backend in background..."
    uvicorn src.ranking.main:app --reload --host 0.0.0.0 --port 8005 &
    @echo "✓ Backend running (PID: $!)"

# Stop background server
dev-stop:
    @echo "⏹️  Stopping backend..."
    pkill -f "uvicorn src.ranking.main:app" || echo "Backend not running"

# Testing
# =======

# Run all tests with coverage
test:
    @echo "🧪 Running tests with coverage..."
    pytest tests/ --cov=src --cov-report=html --cov-report=term -v

# Run tests quickly (no coverage)
test-quick:
    @echo "⚡ Running tests (quick mode)..."
    pytest tests/ -v --tb=short

# Run specific test file
test-file FILE:
    @echo "🎯 Running tests in {{FILE}}..."
    pytest {{FILE}} -v

# Run tests in watch mode
test-watch:
    @echo "👀 Running tests in watch mode..."
    pytest-watch tests/ -- --cov=src

# Run only unit tests
test-unit:
    @echo "🧪 Running unit tests..."
    pytest tests/ -m unit -v

# Run only integration tests
test-integration:
    @echo "🔗 Running integration tests..."
    pytest tests/ -m integration -v

# Code Quality
# ============

# Format code with black
format:
    @echo "✨ Formatting code..."
    black src/ tests/

# Check formatting without modifying
format-check:
    @echo "🔍 Checking code formatting..."
    black --check src/ tests/

# Lint code with ruff
lint:
    @echo "🔍 Linting code..."
    ruff check src/ tests/

# Fix linting issues
lint-fix:
    @echo "🔧 Fixing linting issues..."
    ruff check --fix src/ tests/

# Run all quality checks
quality: format-check lint
    @echo "✅ All quality checks passed"

# Database
# ========

# Initialize TimescaleDB schema
db-init:
    @echo "🗄️  Initializing database schema..."
    psql -f src/db/timescale_init.sql {{DATABASE_URL}}

# Drop and recreate database
db-reset:
    @echo "⚠️  Resetting database..."
    psql {{DATABASE_URL}} -c "DROP TABLE IF EXISTS decisions CASCADE;"
    just db-init

# Show database stats
db-stats:
    @echo "📊 Database statistics..."
    psql {{DATABASE_URL}} -c "SELECT COUNT(*) as total_decisions FROM decisions;" || echo "Database not initialized"

# Observability
# =============

# Start Prometheus
prom:
    @echo "📊 Starting Prometheus on http://localhost:9090"
    prometheus --config.file=prometheus.yml

# Start Grafana
grafana:
    @echo "📈 Starting Grafana on http://localhost:3003"
    grafana-server --config=/etc/grafana/grafana.ini

# View current metrics
metrics:
    @echo "📊 Current metrics:"
    @curl -s http://localhost:8005/metrics | grep ai_agent || echo "Backend not running"

# Check health
health:
    @echo "🏥 Backend health:"
    @curl -s http://localhost:8005/health | jq || echo "Backend not running"

# API Testing
# ===========

# Test /rank endpoint with sample decision
rank-test TYPE="test":
    @echo "🎯 Testing /rank endpoint..."
    @curl -X POST http://localhost:8005/rank \
      -H "Content-Type: application/json" \
      -d '{"agent_id":"test","decision_type":"{{TYPE}}","context":{},"proposed_action":"test"}' \
      | jq

# Test /rank with STF violation
rank-violation:
    @echo "⚠️  Testing STF violation..."
    @curl -X POST http://localhost:8005/rank \
      -H "Content-Type: application/json" \
      -d '{"agent_id":"test","decision_type":"dependency_install","context":{"method":"pip_install"},"proposed_action":"pip install numpy"}' \
      | jq

# Get STF context
stf-context FORMAT="markdown":
    @echo "📜 Fetching STF context ({{FORMAT}})..."
    @curl -s "http://localhost:8000/stf/context?format={{FORMAT}}" | jq

# Load Testing
# ============

# Run load test with locust (if installed)
load-test:
    @echo "🔥 Running load test..."
    @if command -v locust &> /dev/null; then \
      locust -f tests/load/test_ranking_load.py --host http://localhost:8005; \
    else \
      echo "❌ Locust not installed. Install with: pip install locust"; \
    fi

# Quick load test (100 requests)
load-quick:
    @echo "⚡ Quick load test..."
    @for i in {1..100}; do \
      curl -s -X POST http://localhost:8005/rank \
        -H "Content-Type: application/json" \
        -d '{"agent_id":"load-test","decision_type":"test","context":{},"proposed_action":"test"}' \
        > /dev/null & \
    done
    @wait
    @echo "✓ Completed 100 requests"

# Setup
# =====

# Complete setup (first time)
setup:
    @echo "🔧 Running complete setup..."
    @just db-init
    @just test
    @echo "✅ Setup complete!"

# Clean
# =====

# Clean Python cache files
clean:
    @echo "🧹 Cleaning cache files..."
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    find . -type f -name "*.pyc" -delete
    rm -rf .pytest_cache htmlcov .coverage

# Clean everything (including build artifacts)
clean-all: clean
    @echo "🧹 Deep cleaning..."
    rm -rf build/ dist/ *.egg-info

# Utilities
# =========

# Show environment variables
env:
    @echo "📋 Environment variables:"
    @echo "  PYTHONPATH:      {{PYTHONPATH}}"
    @echo "  STF_PATH:        {{STF_PATH}}"
    @echo "  DATABASE_URL:    {{DATABASE_URL}}"
    @echo "  ALLOWED_ORIGINS: {{ALLOWED_ORIGINS}}"

# Check if all services are running
status:
    @echo "🏥 Service Status:"
    @if curl -s http://localhost:8005/health &> /dev/null; then \
      echo "  ✅ Backend:    Running on :8000"; \
    else \
      echo "  ❌ Backend:    Not running"; \
    fi
    @if curl -s http://localhost:9090/-/healthy &> /dev/null; then \
      echo "  ✅ Prometheus: Running on :9090"; \
    else \
      echo "  ❌ Prometheus: Not running"; \
    fi
    @if curl -s http://localhost:3001 &> /dev/null; then \
      echo "  ✅ Grafana:    Running on :3001"; \
    else \
      echo "  ❌ Grafana:    Not running"; \
    fi

# Open important URLs
open-urls:
    @echo "🌐 Opening URLs..."
    @if command -v xdg-open &> /dev/null; then \
      xdg-open http://localhost:8000/docs; \
      xdg-open http://localhost:9090; \
    else \
      echo "📍 Backend API: http://localhost:8000/docs"; \
      echo "📍 Prometheus:  http://localhost:9090"; \
    fi

# Complete workflow
# =================

# Start all services
start-all:
    @echo "🚀 Starting all services..."
    @just dev-bg
    @sleep 2
    @just prom &
    @echo "✅ All services started"
    @just status

# Stop all services
stop-all:
    @echo "⏹️  Stopping all services..."
    @just dev-stop
    @pkill -f prometheus || true
    @pkill -f grafana || true
    @echo "✅ All services stopped"

# Full development workflow
workflow:
    @echo "🔄 Running full development workflow..."
    @just clean
    @just format
    @just lint
    @just test
    @echo "✅ Workflow complete!"

# CI/CD simulation
ci:
    @echo "🤖 Running CI checks..."
    @just format-check
    @just lint
    @just test
    @echo "✅ CI checks passed!"

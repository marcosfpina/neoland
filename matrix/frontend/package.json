{
  "name": "ai-assistant-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Frontend dashboard for AI Assistant ecosystem - AI-powered development tools with multi-LLM support, code analysis, and agent orchestration.",
  "keywords": [
    "developer-tools",
    "ai-assistant",
    "code-analysis",
    "performance-benchmarking",
    "local-development",
    "productivity",
    "multi-llm",
    "agent-orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/ai-assistant-frontend.git"
  },
  "license": "MIT",
  "scripts": {
    "benchmark": "./benchmark.sh",
    "benchmark:ci": "./benchmarks/run-all.sh && echo 'CI benchmark suite completed'",
    "benchmark:full": "./benchmarks/run-all.sh",
    "benchmark:load": "node benchmarks/load-test.js",
    "benchmark:profile": "python3 benchmarks/performance-profiler.py",
    "benchmark:quick": "./benchmark.sh && echo 'Quick benchmark completed'",
    "benchmark:stress": "node benchmarks/load-test.js --concurrency=50 --duration=60000",
    "build": "next build",
    "dev": "next dev",
    "lint": "next lint",
    "load-test": "node benchmarks/load-test.js --concurrency=20 --duration=30000",
    "monitor": "python3 benchmarks/performance-profiler.py --duration=300",
    "start": "next start",
    "test:performance": "npm run benchmark:full"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^0.0.15",
    "@ai-sdk/cohere": "^0.0.10",
    "@ai-sdk/google": "^0.0.15",
    "@ai-sdk/mistral": "^0.0.8",
    "@ai-sdk/openai": "^0.0.20",
    "@hookform/resolvers": "^3.3.2",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-alert-dialog": "^1.0.5",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slider": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "ai": "^3.0.0",
    "autoprefixer": "^10.0.1",
    "child_process": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^2.30.0",
    "fs": "latest",
    "groq-sdk": "^0.5.0",
    "http": "latest",
    "https": "latest",
    "lucide-react": "^0.454.0",
    "next": "15.1.3",
    "ollama": "^0.5.0",
    "path": "latest",
    "perf_hooks": "latest",
    "postcss": "^8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.47.0",
    "recharts": "latest",
    "replicate": "^0.25.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^4.1.9",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "latest",
    "typescript": "^5",
    "util": "latest",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22",
    "bc": "^0.1.1",
    "eslint": "^8",
    "eslint-config-next": "15.1.3",
    "jq": "^1.7.2",
    "postcss": "^8.5",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}

# AI Assistant Frontend - Just Commands
# ======================================
# Task runner for Next.js development operations.
#
# Usage:
#   just --list       - Show all available commands
#   just dev          - Start development server
#   just build        - Build for production

# Variables
export NEXT_PUBLIC_BACKEND_URL := env_var_or_default('NEXT_PUBLIC_BACKEND_URL', 'http://localhost:8000')
export NODE_ENV := env_var_or_default('NODE_ENV', 'development')

# Default recipe
default:
    @just --list

# Development
# ===========

# Start development server
dev:
    @echo "🚀 Starting frontend on http://localhost:3006"
    PORT=3006 npm run dev

# Start development server on custom port
dev-port PORT="3006":
    @echo "🚀 Starting frontend on http://localhost:{{PORT}}"
    PORT={{PORT}} npm run dev

# Start development server in Turbo mode
dev-turbo:
    @echo "⚡ Starting frontend (Turbo mode)"
    npm run dev --turbo

# Build
# =====

# Build for production
build:
    @echo "🏗️  Building for production..."
    npm run build

# Build and analyze bundle size
build-analyze:
    @echo "📊 Building with bundle analyzer..."
    ANALYZE=true npm run build

# Start production server
start:
    @echo "🚀 Starting production server..."
    npm start

# Start production server on custom port
start-port PORT="3006":
    @echo "🚀 Starting production server on :{{PORT}}"
    PORT={{PORT}} npm start

# Dependencies
# ============

# Install dependencies
install:
    @echo "📦 Installing dependencies..."
    npm install

# Update dependencies
update:
    @echo "⬆️  Updating dependencies..."
    npm update

# Audit dependencies for vulnerabilities
audit:
    @echo "🔍 Auditing dependencies..."
    npm audit

# Fix vulnerabilities
audit-fix:
    @echo "🔧 Fixing vulnerabilities..."
    npm audit fix

# Clean install
clean-install:
    @echo "🧹 Clean installing dependencies..."
    rm -rf node_modules package-lock.json
    npm install

# Code Quality
# ============

# Run ESLint
lint:
    @echo "🔍 Linting code..."
    npm run lint

# Fix linting issues
lint-fix:
    @echo "🔧 Fixing linting issues..."
    npm run lint -- --fix

# Check TypeScript types
type-check:
    @echo "🔍 Checking TypeScript types..."
    tsc --noEmit

# Format code with Prettier
format:
    @echo "✨ Formatting code..."
    npx prettier --write "**/*.{js,jsx,ts,tsx,json,css,md}"

# Check formatting
format-check:
    @echo "🔍 Checking code formatting..."
    npx prettier --check "**/*.{js,jsx,ts,tsx,json,css,md}"

# Run all quality checks
quality: format-check lint type-check
    @echo "✅ All quality checks passed"

# Testing
# =======

# Run tests (if configured)
test:
    @echo "🧪 Running tests..."
    @if [ -f "jest.config.js" ] || [ -f "jest.config.ts" ]; then \
      npm test; \
    else \
      echo "No tests configured"; \
    fi

# Run tests in watch mode
test-watch:
    @echo "👀 Running tests in watch mode..."
    @if [ -f "jest.config.js" ] || [ -f "jest.config.ts" ]; then \
      npm test -- --watch; \
    else \
      echo "No tests configured"; \
    fi

# Run tests with coverage
test-coverage:
    @echo "📊 Running tests with coverage..."
    @if [ -f "jest.config.js" ] || [ -f "jest.config.ts" ]; then \
      npm test -- --coverage; \
    else \
      echo "No tests configured"; \
    fi

# Backend Integration
# ===================

# Check backend health
backend-health:
    @echo "🏥 Checking backend health..."
    @curl -s http://localhost:8000/health | jq || echo "Backend not running"

# Test backend /rank endpoint
backend-rank TYPE="test":
    @echo "🎯 Testing backend /rank..."
    @curl -X POST http://localhost:8000/rank \
      -H "Content-Type: application/json" \
      -d '{"agent_id":"frontend-test","decision_type":"{{TYPE}}","context":{},"proposed_action":"test"}' \
      | jq

# View backend metrics
backend-metrics:
    @echo "📊 Backend metrics:"
    @curl -s http://localhost:8000/metrics | grep ai_agent || echo "Backend not running"

# Get STF context
backend-stf:
    @echo "📜 STF context:"
    @curl -s http://localhost:8000/stf/context?format=markdown | jq

# System
# ======

# Show environment variables
env:
    @echo "📋 Environment variables:"
    @echo "  NEXT_PUBLIC_BACKEND_URL: {{NEXT_PUBLIC_BACKEND_URL}}"
    @echo "  NODE_ENV:                {{NODE_ENV}}"

# Check service status
status:
    @echo "🏥 Service Status:"
    @if curl -s http://localhost:3006 &> /dev/null; then \
      echo "  ✅ Frontend:  Running on :3006"; \
    else \
      echo "  ❌ Frontend:  Not running"; \
    fi
    @if curl -s http://localhost:8000/health &> /dev/null; then \
      echo "  ✅ Backend:   Running on :8000"; \
    else \
      echo "  ❌ Backend:   Not running"; \
    fi
    @if systemctl is-active ollama &> /dev/null; then \
      echo "  ✅ Ollama:    Running"; \
    else \
      echo "  ❌ Ollama:    Not running"; \
    fi

# Clean
# =====

# Clean build artifacts
clean:
    @echo "🧹 Cleaning build artifacts..."
    rm -rf .next out

# Clean dependencies
clean-deps:
    @echo "🧹 Cleaning dependencies..."
    rm -rf node_modules

# Clean everything
clean-all: clean clean-deps
    @echo "🧹 Cleaned everything"

# Docker (if using docker-compose)
# =================================

# Start services with docker-compose
docker-up:
    @echo "🐳 Starting services..."
    docker-compose up -d

# Stop services
docker-down:
    @echo "🐳 Stopping services..."
    docker-compose down

# View logs
docker-logs:
    @echo "📜 Service logs:"
    docker-compose logs -f

# Utilities
# =========

# Open browser to app
open:
    @echo "🌐 Opening http://localhost:3006"
    @if command -v xdg-open &> /dev/null; then \
      xdg-open http://localhost:3006; \
    elif command -v open &> /dev/null; then \
      open http://localhost:3006; \
    else \
      echo "Please open http://localhost:3006 manually"; \
    fi

# Open Storybook (if configured)
storybook:
    @echo "📚 Starting Storybook..."
    @if [ -f ".storybook/main.ts" ] || [ -f ".storybook/main.js" ]; then \
      npm run storybook; \
    else \
      echo "Storybook not configured"; \
    fi

# Generate component
component NAME:
    @echo "🎨 Generating component: {{NAME}}"
    @mkdir -p components/{{NAME}}
    @echo "export default function {{NAME}}() {\n  return <div>{{NAME}}</div>\n}" > components/{{NAME}}/{{NAME}}.tsx
    @echo "Created components/{{NAME}}/{{NAME}}.tsx"

# Complete workflows
# ==================

# Full development workflow
workflow:
    @echo "🔄 Running full workflow..."
    @just clean
    @just install
    @just lint
    @just type-check
    @just build
    @echo "✅ Workflow complete!"

# CI/CD simulation
ci:
    @echo "🤖 Running CI checks..."
    @just lint
    @just type-check
    @just build
    @echo "✅ CI checks passed!"

# Quick start (install + dev)
quick-start:
    @just install
    @just dev

{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/main/packages/api/schema.json",
  "productName": "Neoland",
  "version": "0.4.0",
  "identifier": "com.voidnxsec.neoland",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "cd ../web && trunk serve",
    "beforeBuildCommand": "cd ../web && trunk build --release"
  },
  "app": {

    "trayIcon": {
      "id": "neoland-tray",
      "iconPath": "icons/tray-icon.png",
      "tooltip": "Neoland AI Console"
    },
    "windows": [
      {
        "title": "Neoland Console",
        "width": 1280,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "wix": {}
    }
  }
}

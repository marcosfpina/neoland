#!/usr/bin/env bash
# NEOLAND Pre-commit Hook (Optimized)
# Staged-only checks + skip if only docs/CI changed
# Set S NOVERIFY=1 to bypass all checks

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ─── Bootstrap: re-exec inside nix develop ──────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ -f "$PROJECT_ROOT/flake.nix" ] && [ -z "${IN_NIX_SHELL:-}" ]; then
    exec nix develop --command bash "$PROJECT_ROOT/.githooks/pre-commit" "$@"
fi

# ─── Config ──────────────────────────────────────────────────────────────

# Patterns that, when ALL changed files match, skip all checks
SKIP_PATTERNS=(
    '*.md'
    '*.patch'
    'docs/**'
    '.github/**'
    '.codex'
    'LICENSE'
    'secrets/**'
    'fix_*.py'
    'patch_*.py'
    'patch_*.patch'
    '*.gitignore'
    '*.sops.yaml'
    '*.lock'
    'flake.lock'
)

# ─── Helpers ─────────────────────────────────────────────────────────────

step()   { echo -e "  ${BLUE}▶${NC} $1"; }
ok()     { echo -e "  ${GREEN}✔${NC} $1"; }
fail()   { echo -e "  ${RED}✘${NC} $1"; }
skip()   { echo -e "  ${YELLOW}⊘${NC} $1"; }

should_skip_all() {
    local staged
    staged=$(git diff --cached --name-only)
    [ -z "$staged" ] && return 0

    local all_match=true
    while IFS= read -r file; do
        local matched=false
        for pattern in "${SKIP_PATTERNS[@]}"; do
            if [[ "$file" == $pattern ]]; then
                matched=true
                break
            fi
        done
        if [ "$matched" = false ]; then
            all_match=false
            break
        fi
    done <<< "$staged"

    $all_match
}

# ─── Main ────────────────────────────────────────────────────────────────

echo ""
echo -e "${BLUE}┌──────────────────────────────────────────────┐${NC}"
echo -e "${BLUE}│  🔍  Neoland pre-commit checks               │${NC}"
echo -e "${BLUE}└──────────────────────────────────────────────┘${NC}"
echo ""

# Check for bypass
if [ "${SKIP_VERIFY:-0}" = "1" ]; then
    skip "SKIP_VERIFY=1 — bypassing all checks"
    echo ""
    exit 0
fi

# Gather staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
RUST_STAGED=$(echo "$STAGED_FILES" | grep -E '\.rs$' || true)
NIX_STAGED=$(echo "$STAGED_FILES" | grep -E '\.nix$' || true)

if [ -z "$STAGED_FILES" ]; then
    skip "No staged files — nothing to check"
    echo ""
    exit 0
fi

# Check if we can skip entirely
if should_skip_all; then
    skip "Only docs/CI/MD files changed — skipping pre-commit checks"
    echo ""
    exit 0
fi

# ─── 1. Auto-format staged Nix files ────────────────────────────────────

if [ -n "$NIX_STAGED" ]; then
    if command -v nixfmt-rfc-style &>/dev/null; then
        step "Auto-formatting Nix files..."
        while IFS= read -r file; do
            full_path="$PROJECT_ROOT/$file"
            if [ -f "$full_path" ]; then
                nixfmt-rfc-style "$full_path"
                git add "$full_path"
            fi
        done <<< "$NIX_STAGED"
        ok "Nix files formatted and re-staged"
    else
        skip "nixfmt-rfc-style not in PATH — skipping (run inside nix develop for auto-format)"
    fi
else
    skip "No Nix files staged — skipping nix format"
fi

# ─── 3. Format check (staged Rust files only) ───────────────────────────

PASSED=true

if [ -n "$RUST_STAGED" ]; then
    step "Checking Rust formatting (staged files)..."

    if cargo fmt --check 2>/dev/null; then
        ok "All staged Rust files are formatted"
    else
        fail "One or more Rust files are not formatted"
        echo -e "  ${YELLOW}💡 Run:${NC} cargo fmt"
        echo ""
        exit 1
    fi
else
    skip "No Rust files staged — skipping format check"
fi

# ─── 4. Clippy (quick check on lib) ─────────────────────────────────────

step "Running clippy (lib, deny warnings)..."

if cargo clippy --lib --quiet -- -D warnings 2>/dev/null; then
    ok "Clippy passed"
else
    # Give more details on failure
    cargo clippy --lib -- -D warnings 2>&1 | tail -20
    fail "Clippy failed"
    echo -e "  ${YELLOW}💡 Run:${NC} cargo clippy --lib -- -D warnings"
    echo ""
    exit 1
fi

# ─── 5. Unit tests (lib only, fast) ─────────────────────────────────────

step "Running unit tests..."

if cargo test --lib --quiet 2>/dev/null; then
    ok "All unit tests passed"
else
    fail "Unit tests failed"
    echo -e "  ${YELLOW}💡 Run:${NC} cargo test --lib"
    echo ""
    exit 1
fi

# ─── 6. Quick compilation check ─────────────────────────────────────────

step "Checking compilation..."

if cargo check --quiet 2>/dev/null; then
    ok "Compilation OK"
else
    fail "Compilation failed"
    echo ""
    exit 1
fi

# ─── Done ────────────────────────────────────────────────────────────────

echo ""
echo -e "${GREEN}┌──────────────────────────────────────────────┐${NC}"
echo -e "${GREEN}│  ✅  All pre-commit checks passed!           │${NC}"
echo -e "${GREEN}└──────────────────────────────────────────────┘${NC}"
echo ""

#!/usr/bin/env bash
# NEOLAND Pre-push Hook
# Lightweight verification before pushing to remote
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Re-launch inside nix develop if not already inside
if [ -f "$PROJECT_ROOT/flake.nix" ] && [ -z "${IN_NIX_SHELL:-}" ]; then
    exec nix develop --command .githooks/pre-push "$@"
fi

# Parse remote and URL from stdin (git push passes these)
REMOTE="$1"
URL="$2"

echo ""
echo "┌─────────────────────────────────────────────┐"
echo "│  🔍 Neoland Pre-push Checks                 │"
echo "└─────────────────────────────────────────────┘"
echo ""

# ─── 1. Check for unresolved merge conflicts ────────────────────────────────
echo "1️⃣  Checking for unresolved merge conflict markers..."
CONFLICT_FILES=$(git diff --cached --name-only -G'<<<<<<<|=======|>>>>>>>' 2>/dev/null || true)
if [ -n "$CONFLICT_FILES" ]; then
    echo -e "${RED}❌ Merge conflict markers found in:${NC}"
    echo "$CONFLICT_FILES"
    exit 1
fi
echo -e "${GREEN}✅ No merge conflicts${NC}"
echo ""

# ─── 2. Check for large files being pushed ───────────────────────────────────
echo "2️⃣  Checking for unexpectedly large files (≥ 1MB)..."
LARGE_FILES=$(git diff --cached --name-only --diff-filter=ACMRT | \
    xargs -I{} sh -c 'test -f "{}" && test "$(stat --printf=%s "{}" 2>/dev/null || echo 0)" -ge 1048576 && echo "{}"' 2>/dev/null || true)
if [ -n "$LARGE_FILES" ]; then
    echo -e "${YELLOW}⚠️  Large files detected:${NC}"
    echo "$LARGE_FILES"
    echo "   Review if these should be committed."
fi
echo -e "${GREEN}✅ Size check done${NC}"
echo ""

# ─── 3. Check for TODO/FIXME left in staged changes ──────────────────────────
echo "3️⃣  Checking for staled TODO/FIXME markers in staged changes..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMRT 2>/dev/null || true)
if [ -n "$STAGED_FILES" ]; then
    TODOS=$(grep -rn 'TODO\|FIXME\|HACK\|XXX' --include='*.rs' --include='*.py' --include='*.nix' \
        $(echo "$STAGED_FILES" | sed 's/^/-e /') 2>/dev/null || true)
    if [ -n "$TODOS" ]; then
        echo -e "${YELLOW}⚠️  Remaining TODO/FIXME markers:${NC}"
        echo "$TODOS" | head -10
        echo "   (Showing up to 10 matches)"
    fi
fi
echo -e "${GREEN}✅ Marker check done${NC}"
echo ""

# ─── 4. Quick compilation check ──────────────────────────────────────────────
echo "4️⃣  Running quick compilation check..."
if cargo check --lib --quiet 2>/dev/null; then
    echo -e "${GREEN}✅ Compilation OK${NC}"
else
    echo -e "${RED}❌ Compilation failed! Run 'cargo check' locally.${NC}"
    exit 1
fi
echo ""

echo -e "${GREEN}✨ All pre-push checks passed! Push away.${NC}"
echo ""

+        # O Atalho Supremos
+        neolandGodModeCmd = pkgs.writeShellApplication {
+          name = "neoland-up";
+          runtimeInputs = with pkgs; [ tmux ];
+          text = ''
+            echo "🚀 Launching Neoland Full Stack (God Mode)..."
+            # Start a tmux session detached
+            tmux new-session -d -s neoland-stack 'neoland server'
+            # Split window vertically for DSPy
+            tmux split-window -h 'cd agents && poetry run uvicorn neoland_agents.app:app --reload --port 8001'
+            # Split left window horizontally for TUI Client
+            tmux select-pane -t 0
+            tmux split-window -v 'sleep 2 && neoland client'
+            # Attach to the session
+            tmux -2 attach-session -t neoland-stack
+          '';
+        };
 

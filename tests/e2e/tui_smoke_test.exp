#!/usr/bin/expect -f
# E2E Smoke Test for NEOLAND TUI
# Tests: Basic message send → receive response workflow

set timeout 30
set server_url [lindex $argv 0]
set ml_api_url [lindex $argv 1]

# Default URLs if not provided
if {$server_url == ""} {
    set server_url "http://localhost:3001"
}
if {$ml_api_url == ""} {
    set ml_api_url "http://localhost:8000"
}

puts "🧪 TUI Smoke Test"
puts "   Server: $server_url"
puts "   ML API: $ml_api_url"
puts ""

# Start TUI client
spawn cargo run --bin neoland -- tui --server-url $server_url --ml-api-url $ml_api_url

# Wait for TUI to load
expect {
    timeout {
        puts "❌ FAIL: TUI failed to start within 30 seconds"
        exit 1
    }
    "NEOLAND" {
        puts "✅ PASS: TUI started successfully"
    }
}

# Wait a bit for full initialization
sleep 2

# Test 1: Send a simple message
puts "\n📝 Test 1: Send simple message 'Hello'"
send "Hello\r"

# Wait for response
expect {
    timeout {
        puts "❌ FAIL: No response received within 30 seconds"
        exit 1
    }
    -re "(Hello|Hi|Hey)" {
        puts "✅ PASS: Received response from LLM"
    }
}

# Test 2: Send a second message to test conversation flow
puts "\n📝 Test 2: Send follow-up message"
send "What is 2+2?\r"

expect {
    timeout {
        puts "❌ FAIL: No response to math question"
        exit 1
    }
    -re "(4|four)" {
        puts "✅ PASS: Received correct answer (4)"
    }
}

# Test 3: Clear chat
puts "\n📝 Test 3: Clear chat (Ctrl+L)"
send "\014"  ;# Ctrl+L

expect {
    "Chat limpo" {
        puts "✅ PASS: Chat cleared successfully"
    }
    timeout {
        puts "⚠️  WARN: Chat clear confirmation not visible (may still work)"
    }
}

# Test 4: Quit application
puts "\n📝 Test 4: Quit application (Ctrl+C)"
send "\003"  ;# Ctrl+C

expect {
    eof {
        puts "✅ PASS: Application quit cleanly"
    }
    timeout {
        puts "❌ FAIL: Application did not quit"
        exit 1
    }
}

puts "\n✅ All TUI smoke tests passed!"
exit 0
